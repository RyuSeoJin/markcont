{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markcont",
  "mainBinaryName": "markcont",
  "version": "1.2.1",
  "identifier": "com.markcont.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "markcont",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "markcont 마크다운 뷰어",
    "longDescription": "마크다운 파일을 보기 좋게 보고 편집하는 뷰어",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "마크다운 문서",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
